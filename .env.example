# One key, all models. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# TxODDS TxLINE (the 8th competitor: the betting market itself).
# One-time setup: subscribe on-chain with a Solana wallet, then activate —
# see scripts/txodds-setup.mjs and docs/txodds-integration.md.
TXODDS_API_TOKEN=
# TXODDS_ENV=mainnet     # or devnet (txline-dev.txodds.com)
# TXODDS_COMPETITION_ID=72  # FIFA World Cup on the TxLINE feed
# TXODDS_API_ORIGIN=     # override the API origin entirely

# Optional overrides
# PORT=3000
# AUTO_PREDICT=0        # disable the background forecast collector
# DEMO_MODE=1           # deterministic placeholder forecasts, no key needed
# OPENROUTER_BASE_URL=  # point at a compatible proxy for testing
# DATA_DIR=             # where predictions are stored (default ./data)
